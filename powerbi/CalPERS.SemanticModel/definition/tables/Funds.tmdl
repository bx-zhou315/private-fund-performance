table Funds

	measure 'Fund Count' = COUNTROWS ( Funds )
		formatString: #,0

	measure 'Paid In' = DIVIDE ( SUM ( Funds[Paid In USD] ), 1000000000 )
		formatString: $0.00"bn"

	measure 'Residual NAV' = DIVIDE ( SUM ( Funds[NAV USD] ), 1000000000 )
		formatString: $0.00"bn"

	measure 'IRR Flags' = CALCULATE ( [Fund Count], KEEPFILTERS ( Funds[IRR Review] = TRUE() ) )
		formatString: #,0

	measure 'Median DPI' = MEDIAN ( Funds[DPI] )
		formatString: 0.00"x"

	measure 'Median TVPI' = MEDIAN ( Funds[TVPI] )
		formatString: 0.00"x"

	measure 'DPI Observations' = COUNT ( Funds[DPI] ) + 0
		formatString: #,0

	measure 'TVPI Observations' = COUNT ( Funds[TVPI] ) + 0
		formatString: #,0

	measure 'IRR Available' = CALCULATE ( COUNT ( Funds[Source IRR] ), KEEPFILTERS ( Funds[IRR Review] = FALSE() ) )
		formatString: #,0

	measure 'Multiples Reconciled' = CALCULATE ( [Fund Count], KEEPFILTERS ( Funds[Multiple Check] = "Within rounding" ) )
		formatString: #,0

	column 'Programme Key'
		dataType: string
		sourceColumn: Programme Key
		summarizeBy: none
		isHidden

	column 'Source Row'
		dataType: int64
		sourceColumn: Source Row
		summarizeBy: none
		formatString: #,0

	column Fund
		dataType: string
		sourceColumn: Fund
		summarizeBy: none

	column Vintage
		dataType: int64
		sourceColumn: Vintage
		summarizeBy: none
		formatString: 0

	column 'Committed USD'
		dataType: int64
		sourceColumn: Committed USD
		summarizeBy: none
		formatString: #,0

	column 'Paid In USD'
		dataType: int64
		sourceColumn: Paid In USD
		summarizeBy: none
		formatString: #,0

	column 'Distributions USD'
		dataType: int64
		sourceColumn: Distributions USD
		summarizeBy: none
		formatString: #,0

	column 'NAV USD'
		dataType: int64
		sourceColumn: NAV USD
		summarizeBy: none
		formatString: #,0

	column DPI
		dataType: double
		sourceColumn: DPI
		summarizeBy: none
		formatString: 0.00"x"

	column RVPI
		dataType: double
		sourceColumn: RVPI
		summarizeBy: none
		formatString: 0.00"x"

	column TVPI
		dataType: double
		sourceColumn: TVPI
		summarizeBy: none
		formatString: 0.00"x"

	column 'Reported Multiple'
		dataType: double
		sourceColumn: Reported Multiple
		summarizeBy: none
		formatString: 0.00"x"

	column 'Source IRR'
		dataType: double
		sourceColumn: Source IRR
		summarizeBy: none
		formatString: 0.0%

	column 'Multiple Check'
		dataType: string
		sourceColumn: Multiple Check
		summarizeBy: none

	column 'Early Life'
		dataType: boolean
		sourceColumn: Early Life
		summarizeBy: none

	column 'IRR Review'
		dataType: boolean
		sourceColumn: IRR Review
		summarizeBy: none

	column 'Source URL'
		dataType: string
		sourceColumn: Source URL
		summarizeBy: none
		isHidden

