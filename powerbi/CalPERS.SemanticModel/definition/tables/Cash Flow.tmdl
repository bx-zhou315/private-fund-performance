table 'Cash Flow'

	measure 'Cumulative Net Flow' = SELECTEDVALUE ( 'Cash Flow'[Cumulative Net] )
		formatString: 0.0

	column 'Scenario Key'
		dataType: string
		sourceColumn: Scenario Key
		summarizeBy: none
		isHidden

	column 'Quarter End'
		dataType: dateTime
		sourceColumn: Quarter End
		summarizeBy: none
		formatString: yyyy-MM-dd

	column 'Capital Call'
		dataType: double
		sourceColumn: Capital Call
		summarizeBy: none
		formatString: 0.00

	column Distribution
		dataType: double
		sourceColumn: Distribution
		summarizeBy: none
		formatString: 0.00

	column NAV
		dataType: double
		sourceColumn: NAV
		summarizeBy: none
		formatString: 0.00

	column 'Net Cash Flow'
		dataType: double
		sourceColumn: Net Cash Flow
		summarizeBy: none
		formatString: 0.00

	column 'Cumulative Net'
		dataType: double
		sourceColumn: Cumulative Net
		summarizeBy: none
		formatString: 0.00

	column 'Benchmark Level'
		dataType: double
		sourceColumn: Benchmark Level
		summarizeBy: none
		formatString: 0.00

