-- Paste one EVALUATE block at a time in Power BI Desktop's DAX query view.
EVALUATE
SUMMARIZECOLUMNS (
    Programme[Programme],
    "Funds", [Fund Count],
    "Paid in (USD bn)", [Paid In],
    "Multiples reconciled", [Multiples Reconciled],
    "IRR flags", [IRR Flags]
)
ORDER BY Programme[Programme]

EVALUATE
SUMMARIZECOLUMNS (
    Programme[Programme],
    TREATAS ( { 2022 }, Vintage[Vintage] ),
    "Cohort size", [Fund Count],
    "Median DPI", [Median DPI],
    "DPI observations", [DPI Observations]
)
ORDER BY Programme[Programme]

EVALUATE
ROW (
    "Base XIRR", [Base XIRR],
    "Delayed XIRR", [Delayed XIRR],
    "Change (percentage points)", [XIRR Change]
)
